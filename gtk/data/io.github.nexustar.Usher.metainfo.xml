<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nexustar.Usher</id>
  <name>usher</name>
  <summary>Manage local coding-agent sessions</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.nexustar">
    <name>nexustar</name>
  </developer>

  <description>
    <p>
      A native GNOME client for usher, which routes and renders the coding-agent
      sessions running on your machine — Claude Code, Codex, and pi.
    </p>
    <p>Browse and steer sessions from the desktop:</p>
    <ul>
      <li>Every session on the host, grouped by working directory</li>
      <li>Live transcripts with collapsible tool calls and inline images</li>
      <li>Send messages, interrupt a turn, and fork a conversation</li>
      <li>Answer permission prompts and agent questions without leaving the app</li>
      <li>Agent profiles and scheduled tasks for the connected server</li>
    </ul>
    <p>
      usher itself runs separately, on this machine or another one; this client
      connects to it over HTTP.
    </p>
  </description>

  <launchable type="desktop-id">io.github.nexustar.Usher.desktop</launchable>

